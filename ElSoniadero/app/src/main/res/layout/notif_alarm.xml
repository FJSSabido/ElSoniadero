<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de la notificación de alarma: mensaje + tres botones propios de la app.
     Tamaños de texto en dp para que quepan aunque el móvil use letra grande. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/nText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#F2EAFF"
        android:textSize="15dp"
        android:text="Buenos días. ¿Qué has soñado?" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nRecord"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_record"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#1A0B2E"
            android:textSize="14dp"
            android:textStyle="bold"
            android:text="Grabar" />

        <TextView
            android:id="@+id/nSnooze"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_btn_snooze"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E4FF1A"
            android:textSize="14dp"
            android:textStyle="bold"
            android:text="Posponer" />

        <TextView
            android:id="@+id/nIgnore"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_btn_ignore"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14dp"
            android:textStyle="bold"
            android:text="Ignorar" />
    </LinearLayout>
</LinearLayout>
