<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">El Soñadero</string>

    <style name="Theme.Sonadero" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/dusk</item>
        <item name="android:colorPrimaryDark">@color/night</item>
        <item name="android:colorAccent">@color/neon</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/mist</item>
        <item name="android:textColorHint">@color/mist</item>
        <item name="android:colorControlNormal">@color/mist</item>
        <item name="android:colorControlActivated">@color/neon</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/neon</item>
        <item name="android:colorBackground">@color/dusk</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/mist</item>
        <item name="android:colorControlActivated">@color/neon</item>
        <item name="android:colorControlNormal">@color/mist</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/night</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnGhost">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/neon</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/mist</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
